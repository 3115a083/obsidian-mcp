# Copy to .env in Dockge. Never commit actual values.
MCP_IMAGE=ghcr.io/3115a083/obsidian-mcp:stable
MCP_GATEWAY_IMAGE=ghcr.io/3115a083/obsidian-mcp-gateway:stable
# URL of THIS MCP application/admin, not the separate Obsidian vault web app.
PUBLIC_URL=https://obsidian-mcp.example.com
GITHUB_CLIENT_ID=replace-with-one-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-locally-with-your-secret
GITHUB_OWNER_ID=replace-with-your-numeric-account-id
VAULT_PARENT=/srv/obsidian/vaults
MCP_UID=568
MCP_GID=568
MCP_BIND_IP=127.0.0.1
MCP_GATEWAY_PORT=3061

# Optional direct ChatGPT OAuth. Use the SAME origin as PUBLIC_URL.
# Pangolin keeps admin protected and bypasses only documented OAuth/MCP paths.
MCP_PUBLIC_URL=
MCP_ORIGIN_SECRET=
